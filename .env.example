# TrustVault stays bound to this machine during local development.
HOST=127.0.0.1
PORT=4000

# Run `npm run setup-auth` in backend/ to create the local .env file safely.
# The setup command prompts for a password without echoing it, stores only a
# scrypt password verifier, and generates both keys. Do not put a plaintext
# password here or share the generated values.
AUTH_PASSWORD_HASH=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Dedicated to AES-256-GCM encryption of the local message store.
# Run `npm run setup-message-key` from backend/ to generate it safely.
MESSAGE_ENCRYPTION_KEY=

# Optional Gmail OAuth foundation. Leave blank to keep Gmail connection disabled.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Fixed callback URI to register in Google Cloud. This is not configurable.
# http://localhost:4000/api/auth/google/callback
